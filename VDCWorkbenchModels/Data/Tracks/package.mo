within VDCWorkbenchModels.Data;
package Tracks "Collection of predefined tracks"
  extends Modelica.Icons.Package;

  annotation (Documentation(info="<html>
<p>
This package contains datasets for predefined tracks. The records defined here can be used for
example as <code>replaceable parameter</code> in various models to simplify track selection,
see e.g. the implementation in
<a href=\"modelica://VDCWorkbenchModels.VehicleComponents.Controllers.VDControl.BaseClasses.BaseVDC\">BaseVDC</a>.
</p>
</html>"));
end Tracks;
